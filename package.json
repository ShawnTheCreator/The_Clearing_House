{
  "name": "the-clearing-house",
  "version": "0.1.0",
  "description": "Agent labor market on NEAR with cryptographically signed evidence receipts",
  "type": "module",
  "main": "gateway/daemon.ts",
  "scripts": {
    "build": "echo 'Static build ready'",
    "start": "node --experimental-strip-types gateway/daemon.ts",
    "dev:home": "npm --prefix home_vite run dev",
    "dev:dashboard": "npm --prefix dashboard_nextjs run dev",
    "build:home": "npm --prefix home_vite run build",
    "build:dashboard": "npm --prefix dashboard_nextjs run build",
    "start:all": "node scripts/start_all.js",
    "start:frontend": "node frontend/serve.js",
    "start:csharp": "dotnet run --project backend_csharp/TheClearingHouse.Api",
    "start:python": "python backend_python/main.py",
    "dashboard": "node --experimental-strip-types dashboard/server.ts",
    "test": "node --experimental-strip-types --test test/**/*.test.ts",
    "reproduce": "node --experimental-strip-types scripts/reproduce.ts",
    "verify-receipt": "node --experimental-strip-types scripts/verify_receipt.ts",
    "ablation": "node --experimental-strip-types scripts/ablation.ts",
    "swarm": "node --experimental-strip-types agents/swarm_orchestrator.ts",
    "subaccounts": "node --experimental-strip-types scripts/subaccount_factory.ts",
    "testnet:deploy": "node --experimental-strip-types scripts/deploy_live.ts",
    "testnet:swarm": "node --experimental-strip-types scripts/live_swarm.ts",
    "verify:live": "node --experimental-strip-types scripts/verify_receipt.ts --receipt rcpt_3VVLCnAEyQKLSiDW"
  },
  "keywords": [
    "near",
    "ai-agents",
    "intents",
    "sub-accounts",
    "evidence-ledger",
    "merkle-tree"
  ],
  "author": "The Clearing House Swarm",
  "license": "Apache-2.0",
  "dependencies": {
    "near-api-js": "^7.2.0"
  },
  "devDependencies": {
    "near-cli": "^4.0.13"
  }
}
